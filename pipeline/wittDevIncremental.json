{
	"name": "wittDevIncremental",
	"properties": {
		"activities": [
			{
				"name": "ForEachCollection",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "LookupCollections",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('LookupCollections').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "CopyWITT",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "MongoDbAtlasSource",
									"batchSize": 100,
									"filter": {
										"value": "{updatedAt: {$gte: ISODate(\"@{pipeline().parameters.windowStart}\"), $lt: ISODate(\"@{pipeline().parameters.windowEnd}\")}}",
										"type": "Expression"
									}
								},
								"sink": {
									"type": "JsonSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "JsonWriteSettings"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "MongoDbAtlasWitt",
									"type": "DatasetReference",
									"parameters": {
										"collectionName": {
											"value": "@item().name",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "UsersDev",
									"type": "DatasetReference",
									"parameters": {
										"folderPath": {
											"value": "@concat('witt_dev/', item().name, '/incremental/', formatDateTime(pipeline().parameters.windowStart, 'yyyy/MM/dd'))",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			},
			{
				"name": "LookupCollections",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "ConfigCollections",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			}
		],
		"parameters": {
			"windowStart": {
				"type": "string",
				"defaultValue": "2026-11-10T00:00:00Z"
			},
			"windowEnd": {
				"type": "string",
				"defaultValue": "2026-11-11T00:00:00Z"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-11-11T19:18:37Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}